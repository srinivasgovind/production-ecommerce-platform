# Copy this file to .env and fill in real values locally.
# .env is git-ignored. Never commit real secrets.

# APP_ENV: local | test | staging | production
APP_ENV=local
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# LOG_FORMAT: json (servers) | console (readable, local)
LOG_FORMAT=console
# Database: used by the app AND by compose.yaml (Postgres container). Required.
DB_PASSWORD=change-me
# Optional, defaults match compose.yaml: DB_HOST=localhost DB_PORT=5432 DB_USER=store DB_NAME=store
REDIS_URL=redis://localhost:6379/0
STRIPE_SECRET_KEY=sk_test_replace_me
